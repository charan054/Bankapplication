# Copy this file to ".env" (same folder) and fill in your real values. ".env" is git-ignored; this example is not.
# Plain KEY=value lines: no quotes, and double any backslash in a value.
DB_PASSWORD=your-mysql-password

# Any long random string works for both of these (e.g. generate one with `openssl rand -hex 32`).
# ADMIN_API_KEY: typed into bank.html once; it is then kept in that browser's localStorage.
ADMIN_API_KEY=change-this-admin-key
# SERVICE_API_KEY: must be the EXACT same value as SERVICE_API_KEY in PhonepayService's own .env.
SERVICE_API_KEY=change-this-service-key

# Forgot-PIN codes are emailed via Gmail SMTP. Optional - leave unset and the app still runs fine, forgot-PIN
# just silently fails to send. MAIL_PASSWORD must be a Gmail App Password (myaccount.google.com/apppasswords),
# not your real Gmail password - Google blocks plain-password SMTP login.
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
